# Copier en .env et remplir le mot de passe.
DATABASE_URL=postgresql+psycopg://postgres:MOTDEPASSE@localhost:5432/attrition
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:MOTDEPASSE@localhost:5432/postgres

# Cle d'acces a /predict. En generer une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=VOTRE_CLE

# Cle de signature des jetons JWT. En generer une avec la meme commande.
JWT_SECRET=VOTRE_SECRET

# Base jetable des tests d'integration, jamais la base de travail :
# le schema y rejoue des DROP.
DATABASE_TEST_URL=postgresql+psycopg://postgres:MOTDEPASSE@localhost:5432/attrition_test
